# 制品与权重（体积大，且许可随上游——自行获取；models/ 由 docker/fetch-model.sh 引导落位）
*.ninfer
models/
*.gguf
*.safetensors

# 编译产物
build/
tmp-nvcc/
*.o
*.a

# 运行产物
perf-results-*.json
# docker/ 下的存档例外：文档引用的双线对照证据（docs/性能实测.md §9）
!docker/perf-results-*.json
suite-results-*.json
*.log
*.pid

# Python
__pycache__/
*.pyc
HANDOFF.md

# 魔搭上传缓存（scripts/upload-modelscope.sh 生成）
.ms_upload_cache

# vendor/ 内上游引擎源码树的 models/ 与验证读数 .log 必须完整入库
#（上面的 models/、*.log 规则只针对本仓库自身的制品与运行产物；
#  漏排会导致 CI 里 fusion 引擎 configure 报 add_subdirectory models 不存在）
!vendor/ninfer-fusion-kvmem/**/models/
!vendor/ninfer-fusion-kvmem/**/models/**
!vendor/ninfer-fusion-kvmem/**/*.log
